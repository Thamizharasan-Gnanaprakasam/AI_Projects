# Wispr Flow Alternative - Configuration

# Hotkey to start/stop dictation (pynput format)
# Examples: "<ctrl>+<space>", "<cmd>+<shift>+d", "<alt>+<space>"
WISPR_HOTKEY="<ctrl>+<space>"

# Recording mode: "toggle" (press to start, press to stop) or "push_to_talk"
WISPR_RECORDING_MODE="toggle"

# Speech-to-Text backend:
# "mlx-whisper" -> Local Apple Silicon inference (private, offline, zero subscription)
# "groq"        -> Ultra-fast cloud inference (~300ms, free tier)
WISPR_STT_BACKEND="mlx-whisper"

# MLX Model for local STT:
# Options:
# - "mlx-community/whisper-tiny"             (fastest, ~75MB)
# - "mlx-community/whisper-small"            (balanced, ~480MB)
# - "mlx-community/whisper-large-v3-turbo"   (most accurate multilingual, ~1.5GB)
WISPR_MLX_MODEL="mlx-community/whisper-large-v3-turbo"

# Language: "auto" for automatic detection across 99+ languages, or ISO code (e.g. "en", "es", "fr", "ta", "de")
WISPR_LANGUAGE="auto"

# Tone selection:
# "smart_verbatim" -> cleans fillers/grammar, exact words
# "casual"         -> chat/slack style
# "professional"   -> email/memo format
# "concise"        -> bullet points / executive brief
# "technical"      -> developer / code backticks
WISPR_TONE="professional"

# LLM Backend for Tone Refinement:
# "ollama" -> Local offline via Ollama (e.g. llama3.2:3b, qwen2.5:3b)
# "groq"   -> Ultra-fast free cloud API (llama-3.3-70b)
WISPR_LLM_BACKEND="ollama"

# Local Ollama settings:
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"

# Optional Groq settings (free tier available at https://console.groq.com):
GROQ_API_KEY=""
GROQ_LLM_MODEL="llama-3.3-70b-versatile"
